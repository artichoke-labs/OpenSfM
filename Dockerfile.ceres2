FROM ubuntu:20.04

ARG DEBIAN_FRONTEND=noninteractive

# Install required apt packages with no unnecessary recommendations.
# Removed python3-numpy, python3-scipy, and python3-opencv to avoid conflicts.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    libeigen3-dev \
    libgoogle-glog-dev \
    libopencv-dev \
    libsuitesparse-dev \
    python3-dev \
    python3-pip \
    python3-pyproj \
    python3-yaml \
    curl && \
    apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*


# Build and install Ceres Solver 2 using half of available cores.
RUN mkdir -p /source && cd /source && \
    curl -L http://ceres-solver.org/ceres-solver-2.0.0.tar.gz | tar xz && \
    cd ceres-solver-2.0.0 && mkdir build && cd build && \
    cmake .. -DCMAKE_C_FLAGS=-fPIC -DCMAKE_CXX_FLAGS=-fPIC -DBUILD_EXAMPLES=OFF -DBUILD_TESTING=OFF && \
    cpus=$(nproc) && half=$(( cpus / 2 )) && if [ $half -eq 0 ]; then half=1; fi && \
    make -j$half install && \
    cd /source && rm -rf ceres-solver-2.0.0


COPY . /source/OpenSfM

WORKDIR /source/OpenSfM

RUN pip3 install --no-cache-dir -r requirements.txt && \
    python3 setup.py build
